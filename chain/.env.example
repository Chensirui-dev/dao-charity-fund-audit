# 复制为 chain/.env 后填写。该文件只用于部署，不会被前端打包，请勿提交到仓库。

# Sepolia 公共 RPC。默认用 tenderly 网关（实测国内可直连），
# publicnode / drpc / 1rpc 在国内多数网络下连不上。也可换成 Alchemy / Infura 的专属地址。
SEPOLIA_RPC_URL=https://sepolia.gateway.tenderly.co

# 部署账户私钥（0x 开头）。请使用专用的测试账户，切勿使用主网账户私钥
DEPLOYER_PRIVATE_KEY=0x

# 需要授予治理投票权的 DAO 成员地址，逗号分隔（对应前端四个演示角色）
DAO_MEMBERS=0x,0x,0x,0x

# 演示用投票时长（秒），现场走完整流程建议 120
DEMO_VOTING_PERIOD=120

# 演示用受助方账户私钥（可选）。用款申请只能由登记的收款方本人提交，
# 想用脚本跑通「申请 → 表决 → 拨付」就需要这个私钥；只在前端点的话可以不配。
RECIPIENT_PRIVATE_KEY=0x
